; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SilkMelodyOcean"
config/version="0.1.1"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://autoload/game_state.gd"
Hitstop="*res://autoload/hitstop.gd"
RoomLoader="*res://autoload/room_loader.gd"
SoundManager="*uid://banokm23tjqmc"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1536
window/size/window_height_override=864
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/sound_manager/plugin.cfg")

